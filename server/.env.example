# PrioSync Server — Environment Variables Reference
# Copy this file to .env and fill in the values.
# On Render, set these directly in the "Environment" tab — do NOT commit .env to git.

# The port Render assigns automatically — leave this blank in Render (it injects PORT itself)
PORT=5000

# MongoDB Atlas connection string — include the database name at the end
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/priosync?retryWrites=true&w=majority

# PostgreSQL (Neon) connection string — canonical name is POSTGRES_URI.
# Legacy typo POSTGRESS_URI and generic DATABASE_URL are also accepted by db/pgClient.js.
# Use sslmode=verify-full (pg treats require/prefer as verify-full anyway and warns).
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=verify-full
POSTGRES_URI=postgresql://<user>:<password>@<host>/neondb?sslmode=verify-full

# Secret used to sign JWT tokens — use a long random string in production
JWT_SECRET=replace_with_a_long_random_secret

# JWT expiry duration (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Set to "production" on Render
NODE_ENV=production

# Allowed frontend origins — comma-separated, no trailing slash
# Add your Vercel URL here
CLIENT_URL=https://prio-sync.vercel.app

# Redis (optional — cache + BullMQ queues; app degrades gracefully without it).
# REDIS_URL=redis://localhost:6379
# Auth rate limit (requests per minute per IP on v2 register/login).
# RATE_LIMIT_AUTH_MAX=60

# Integration tests are opt-in and use temp __test__ users with cascade cleanup.
# Point at a throwaway Neon branch in CI — never production.
# RUN_PG_TESTS=1
# npm test        → unit only (no network)
# npm run test:pg → unit + Postgres integration

# Structured log level (debug, info, warn, error). JSON lines to stdout.
# LOG_LEVEL=info
# Requests slower than this are counted in priosync_http_slow.
# SLOW_REQUEST_MS=1000

# LLM for Brain-Dump parsing (optional — heuristic parser is used when unset).
# Any OpenAI-compatible chat-completions endpoint works.
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
